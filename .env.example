# Copiar este archivo a apps/mobile/.env (Expo lee env desde el dir de la app).
# Obtener valores en el dashboard del proyecto Supabase → Settings → API.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key-here

# --- Scripts de contenido (spec 004) ---
# Estos van en un .env en la RAÍZ del repo (no en apps/mobile/.env).
# El service_role key escribe salteándose RLS: úsalo solo en scripts de
# confianza (tu máquina / CI). NUNCA lo commitees ni lo pongas en la app.
# Está en Dashboard → Settings → API → service_role.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
