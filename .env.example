# Copiar este archivo a apps/mobile/.env (Expo lee env desde el dir de la app).
# Obtener valores en el dashboard del proyecto Supabase → Settings → API.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key-here

# Solo backend / scripts locales — nunca commitear en apps/mobile/.env,
# usar un .env separado en scripts si hace falta.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
