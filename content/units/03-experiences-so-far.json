      "teachingCards": [
        {
          "key": "u3l3-t1",
          "titleEs": "Con fecha → pasado simple",
          "bodyEs": "Si la frase incluye un momento definido del pasado (yesterday, last year, in 2010), usamos pasado simple, no presente perfecto.",
          "examples": [
            {
              "en": "I met her last year.",
              "es": "La conocí el año pasado.",
              "goal": "general"
            },
            {
              "en": "She started this job in 2022.",
              "es": "Ella empezó este trabajo en 2022.",
              "goal": "work"
            },
            {
              "en": "We visited Rome two years ago.",
              "es": "Visitamos Roma hace dos años.",
              "goal": "travel"
            },
            {
              "en": "I took that course last semester.",
              "es": "Hice ese curso el semestre pasado.",
              "goal": "study"
            },
            {
              "en": "We watched that movie last weekend.",
              "es": "Miramos esa película el fin de semana pasado.",
              "goal": "entertainment"
            }
          ]
        },
        {
          "key": "u3l3-t2",
          "titleEs": "Sin fecha → presente perfecto",
          "bodyEs": "Sin un momento definido, o para hablar de experiencia general, usamos presente perfecto.",
          "examples": [
            {
              "en": "I have already met her.",
              "es": "Ya la conocí.",
              "goal": "general"
            },
            {
              "en": "She has worked in that role before.",
              "es": "Ella ya trabajó en ese puesto antes.",
              "goal": "work"
            },
            {
              "en": "We have visited Rome before.",
              "es": "Ya visitamos Roma antes.",
              "goal": "travel"
            },
            {
              "en": "I have taken that course before.",
              "es": "Ya hice ese curso antes.",
              "goal": "study"
            },
            {
              "en": "We have watched that movie before.",
              "es": "Ya miramos esa película antes.",
              "goal": "entertainment"
            }
          ]
        },
        {
          "key": "u3l3-t3",
          "titleEs": "How long...? — duración hasta ahora",
          "bodyEs": "Para preguntar cuánto tiempo llevás haciendo algo (que sigue pasando), usamos 'How long have you...?' + presente perfecto. La respuesta usa 'for' + duración o 'since' + inicio.",
          "examples": [
            {
              "en": "How long have you known him?",
              "es": "¿Hace cuánto lo conocés?",
              "goal": "general"
            },
            {
              "en": "How long has she worked here?",
              "es": "¿Hace cuánto trabaja acá?",
              "goal": "work"
            },
            {
              "en": "How long have you been in this city?",
              "es": "¿Hace cuánto estás en esta ciudad?",
              "goal": "travel"
            },
            {
              "en": "How long have you studied English?",
              "es": "¿Hace cuánto estudiás inglés?",
              "goal": "study"
            },
            {
              "en": "How long have you liked that band?",
              "es": "¿Hace cuánto que te gusta esa banda?",
              "goal": "entertainment"
            }
          ]
        },
        {
          "key": "u3l3-t4",
          "titleEs": "recently vs. fecha específica",
          "bodyEs": "'recently' (recientemente, en el pasado cercano sin fecha exacta) suele ir con presente perfecto: 'I have moved recently'. Si das fecha exacta, va pasado simple: 'I moved last month'.",
