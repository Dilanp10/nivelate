        {
          "key": "u3l1-t1",
          "titleEs": "Experiencias sin decir cuándo",
          "bodyEs": "El presente perfecto (have/has + participio) se usa para hablar de experiencias de vida, sin importar en qué momento pasaron.",
          "examples": [
            {
              "en": "I have been to three different countries.",
              "es": "Estuve en tres países distintos.",
              "goal": "general"
            },
            {
              "en": "She has worked in two different companies.",
              "es": "Ella trabajó en dos empresas distintas.",
              "goal": "work"
            },
            {
              "en": "I have traveled by train in Europe.",
              "es": "Viajé en tren por Europa.",
              "goal": "travel"
            },
            {
              "en": "I have studied English for two years.",
              "es": "Estudié inglés durante dos años.",
              "goal": "study"
            },
            {
              "en": "We have watched that series twice.",
              "es": "Miramos esa serie dos veces.",
              "goal": "entertainment"
            }
          ]
        },
        {
          "key": "u3l1-t2",
          "titleEs": "ever y never",
          "bodyEs": "'ever' (alguna vez) se usa en preguntas de experiencia; 'never' (nunca) en negativas. Ambos van entre el auxiliar y el participio.",
          "examples": [
            {
              "en": "Have you ever lost your keys?",
              "es": "¿Alguna vez perdiste las llaves?",
              "goal": "general"
            },
            {
              "en": "Has he ever managed a team?",
              "es": "¿Él alguna vez dirigió un equipo?",
              "goal": "work"
            },
            {
              "en": "I have never been to Asia.",
              "es": "Nunca estuve en Asia.",
              "goal": "travel"
            },
            {
              "en": "She has never failed an exam.",
              "es": "Ella nunca desaprobó un examen.",
              "goal": "study"
            },
            {
              "en": "Have you ever watched a horror movie alone?",
              "es": "¿Alguna vez miraste una película de terror solo?",
              "goal": "entertainment"
            }
          ]
        },
        {
          "key": "u3l1-t3",
          "titleEs": "Preguntas de seguimiento en pasado simple",
          "bodyEs": "Después de una pregunta de experiencia ('Have you ever...?'), las preguntas de seguimiento con detalles específicos van en pasado simple: 'When did you go?', 'Where did you eat?', 'How was it?'",
          "examples": [
            {
              "en": "Have you ever been to Peru? When did you go?",
              "es": "¿Alguna vez estuviste en Perú? ¿Cuándo fuiste?",
              "goal": "general"
            },
            {
              "en": "Have you ever worked from home? How was it?",
              "es": "¿Alguna vez trabajaste desde casa? ¿Qué tal fue?",
              "goal": "work"
            },
            {
              "en": "Have you ever tried surfing? Where did you go?",
              "es": "¿Alguna vez probaste surf? ¿Dónde fuiste?",
              "goal": "travel"
            },
            {
              "en": "Have you ever taken an online course? Did you finish it?",
              "es": "¿Alguna vez tomaste un curso online? ¿Lo terminaste?",
              "goal": "study"
            },
            {
              "en": "Have you seen that show? What did you think?",
              "es": "¿Viste ese show? ¿Qué te pareció?",
              "goal": "entertainment"
            }
          ]
        },
        {
          "key": "u3l1-t4",
          "titleEs": "been vs. gone",
          "bodyEs": "'has been to' = fue y volvió (visitó). 'has gone to' = fue y sigue allá. 'I have been to Paris' significa que ya viajaste; 'She has gone to Paris' significa que ella está en Paris ahora.",
          "examples": [
            {
              "en": "I have been to five countries.",
              "es": "Estuve en cinco países.",
              "goal": "travel"
            },
            {
              "en": "She has gone to the doctor. She'll be back at 5.",
              "es": "Ella fue al médico. Vuelve a las 5.",
              "goal": "general"
            },
            {
              "en": "He has been to that client three times this month.",
              "es": "Estuvo con ese cliente tres veces este mes.",
              "goal": "work"
            },
            {
              "en": "She has gone to the library — call her later.",
              "es": "Ella fue a la biblioteca — llamala después.",
              "goal": "study"
            },
            {
              "en": "They have been to that concert already.",
              "es": "Ellos ya estuvieron en ese concierto.",
              "goal": "entertainment"
            }
          ]
        }
