    {
      "slug": "past-simple-review",
      "title": "Pasado simple",
      "grammarTopicSlugs": [
        "past-simple"
      ],
      "teachingCards": [
        {
          "key": "u1l2-t1",
          "titleEs": "Verbos regulares e irregulares",
          "bodyEs": "El pasado simple se usa para acciones terminadas. Los verbos regulares agregan -ed ('watched'), pero muchos verbos comunes son irregulares y hay que memorizarlos ('go → went').",
          "examples": [
            {
              "en": "I watched a movie last night.",
              "es": "Miré una película anoche.",
              "goal": "general"
            },
            {
              "en": "She finished the report yesterday.",
              "es": "Ella terminó el informe ayer.",
              "goal": "work"
            },
            {
              "en": "We visited three countries last year.",
              "es": "Visitamos tres países el año pasado.",
              "goal": "travel"
            },
            {
              "en": "I studied for the exam all weekend.",
              "es": "Estudié para el examen todo el fin de semana.",
              "goal": "study"
            },
            {
              "en": "They watched the whole series in a week.",
              "es": "Miraron toda la serie en una semana.",
              "goal": "entertainment"
            }
          ]
        },
        {
          "key": "u1l2-t2",
          "titleEs": "Preguntas y negaciones con did",
          "bodyEs": "Para preguntar o negar en pasado usamos did/didn't + el verbo en forma base (nunca en pasado): 'Did you go?', no 'Did you went?'.",
          "examples": [
            {
              "en": "Did you sleep well?",
              "es": "¿Dormiste bien?",
              "goal": "general"
            },
            {
              "en": "Did she call the client?",
              "es": "¿Ella llamó al cliente?",
              "goal": "work"
            },
            {
              "en": "Did you visit the museum?",
              "es": "¿Visitaste el museo?",
              "goal": "travel"
            },
            {
              "en": "I didn't understand the lesson.",
              "es": "No entendí la lección.",
              "goal": "study"
            },
            {
              "en": "We didn't watch the ending.",
              "es": "No vimos el final.",
              "goal": "entertainment"
            }
          ]
        },
        {
          "key": "u1l2-t3",
          "titleEs": "Expresiones de tiempo pasado",
          "bodyEs": "Las expresiones de tiempo pasado te ayudan a saber cuándo usar el pasado simple: yesterday, last week/month/year, ago (dos días atrás → two days ago), in + año, when I was young.",
          "examples": [
            {
              "en": "I saw her yesterday.",
              "es": "La vi ayer.",
              "goal": "general"
            },
            {
              "en": "We had a meeting last week.",
              "es": "Tuvimos una reunión la semana pasada.",
              "goal": "work"
            },
            {
              "en": "They moved here two years ago.",
              "es": "Se mudaron acá hace dos años.",
              "goal": "travel"
            },
            {
              "en": "I finished the course in 2023.",
              "es": "Terminé el curso en 2023.",
              "goal": "study"
            },
            {
              "en": "We watched that film last night.",
              "es": "Vimos esa película anoche.",
              "goal": "entertainment"
            }
          ]
        },
        {
          "key": "u1l2-t4",
          "titleEs": "Los 3 sonidos de -ed",
          "bodyEs": "El -ed regular se pronuncia de tres formas: /t/ después de sonido sordo ('worked → wérkt'), /d/ después de sonido sonoro ('played → pléid'), y /id/ como sílaba extra después de /t/ o /d/ ('wanted → wánted').",
          "examples": [
            {
              "en": "I worked all day yesterday.",
              "es": "Trabajé todo el día ayer.",
              "goal": "general"
            },
            {
              "en": "She finished the presentation.",
              "es": "Ella terminó la presentación.",
              "goal": "work"
            },
            {
              "en": "We visited three museums.",
              "es": "Visitamos tres museos.",
              "goal": "travel"
            },
            {
              "en": "I studied for hours.",
              "es": "Estudié durante horas.",
              "goal": "study"
            },
            {
              "en": "They enjoyed the concert.",
              "es": "Disfrutaron el concierto.",
              "goal": "entertainment"
            }
          ]
        }
      ],
