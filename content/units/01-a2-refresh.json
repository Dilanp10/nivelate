          }
        },
        {
          "key": "u1l1-e5",
          "type": "word_order",
          "payload": {
            "tokens": ["He", "doesn't", "like", "fish"],
            "correctOrder": [0, 1, 2, 3],
            "explanation": "El negativo en presente usa 'doesn't' + verbo base: 'He doesn't like fish.'"
          }
        },
        {
          "key": "u1l1-e6",
          "type": "multiple_choice",
          "payload": {
            "prompt": "___ she speak English?",
            "options": ["Do", "Does", "Is"],
