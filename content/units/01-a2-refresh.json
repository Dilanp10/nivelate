    {
      "slug": "past-simple-review",
      "title": "Pasado simple",
      "grammarTopicSlugs": ["past-simple"],
      "teachingCards": [
        {
          "key": "u1l2-t1",
          "titleEs": "Verbos regulares e irregulares",
          "bodyEs": "El pasado simple se usa para acciones terminadas. Los verbos regulares agregan -ed ('watched'), pero muchos verbos comunes son irregulares y hay que memorizarlos ('go → went').",
          "examples": [
            { "en": "I watched a movie last night.", "es": "Miré una película anoche.", "goal": "general" },
            { "en": "She finished the report yesterday.", "es": "Ella terminó el informe ayer.", "goal": "work" },
            { "en": "We visited three countries last year.", "es": "Visitamos tres países el año pasado.", "goal": "travel" },
            { "en": "I studied for the exam all weekend.", "es": "Estudié para el examen todo el fin de semana.", "goal": "study" },
            { "en": "They watched the whole series in a week.", "es": "Miraron toda la serie en una semana.", "goal": "entertainment" }
          ]
        },
        {
          "key": "u1l2-t2",
          "titleEs": "Preguntas y negaciones con did",
          "bodyEs": "Para preguntar o negar en pasado usamos did/didn't + el verbo en forma base (nunca en pasado): 'Did you go?', no 'Did you went?'.",
          "examples": [
            { "en": "Did you sleep well?", "es": "¿Dormiste bien?", "goal": "general" },
            { "en": "Did she call the client?", "es": "¿Ella llamó al cliente?", "goal": "work" },
            { "en": "Did you visit the museum?", "es": "¿Visitaste el museo?", "goal": "travel" },
            { "en": "I didn't understand the lesson.", "es": "No entendí la lección.", "goal": "study" },
            { "en": "We didn't watch the ending.", "es": "No vimos el final.", "goal": "entertainment" }
          ]
        }
      ],
      "exercises": [
