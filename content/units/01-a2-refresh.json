            "acceptable": [["goes"]],
            "explanation": "'go' en tercera persona del singular es 'goes'."
          }
        },
        {
          "key": "u1l1-e4",
          "type": "fill_in_blank",
          "payload": {
            "segments": ["We ", " TV in the evening."],
            "answers": ["watch"],
