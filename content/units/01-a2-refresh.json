        },
        {
          "key": "u1l2-e5",
          "type": "multiple_choice",
          "payload": {
            "prompt": "I ___ see the message. Sorry!",
            "options": ["didn't", "don't", "wasn't"],
            "correctIndex": 0,
            "explanation": "El negativo en pasado usa 'didn't' + verbo base."
          }
        },
        {
          "key": "u1l2-e6",
          "type": "matching",
          "payload": {
            "pairs": [
              { "left": "go", "right": "went" },
              { "left": "have", "right": "had" },
              { "left": "buy", "right": "bought" },
              { "left": "see", "right": "saw" }
            ],
            "explanation": "Pares de verbo base → pasado simple (todos irregulares)."
          }
        },
        {
          "key": "u1l2-e7",
          "type": "translation",
          "payload": {
            "prompt": "Ella compró un vestido nuevo.",
