  "grammarTopics": [
    {
      "slug": "present-simple",
      "title": "Presente simple",
      "explanationEs": "Se usa para rutinas, hábitos y hechos generales. En tercera persona del singular (he/she/it) el verbo lleva -s: 'She works'. En negativo e interrogativo usamos do/does: 'He doesn't work', 'Does she work?'.",
      "cefrLevel": "A2"
    },
    {
      "slug": "past-simple",
      "title": "Pasado simple",
      "explanationEs": "Se usa para acciones terminadas en el pasado. Los verbos regulares terminan en -ed ('worked'), pero hay muchos irregulares ('go → went', 'have → had'). En negativo e interrogativo usamos did: 'I didn't go', 'Did you go?'.",
      "cefrLevel": "A2"
    },
    {
      "slug": "everyday-vocabulary",
      "title": "Vocabulario cotidiano",
      "explanationEs": "Palabras y expresiones de uso diario: rutinas, casa, comida y tiempo. Base imprescindible para comunicarse en situaciones comunes.",
      "cefrLevel": "A2"
    }
  ],
  "lessons": [
    {
      "slug": "present-simple-review",
      "title": "Presente simple",
      "grammarTopicSlugs": ["present-simple"],
      "teachingCards": [
        {
          "key": "u1l1-t1",
          "titleEs": "Rutinas y hechos generales",
          "bodyEs": "El presente simple se usa para rutinas, hábitos y hechos que siempre son ciertos. Con he/she/it, el verbo lleva -s al final.",
          "examples": [
            { "en": "I wake up early every day.", "es": "Me despierto temprano todos los días.", "goal": "general" },
            { "en": "She manages a small team.", "es": "Ella dirige un equipo pequeño.", "goal": "work" },
            { "en": "He travels twice a year.", "es": "Él viaja dos veces al año.", "goal": "travel" },
            { "en": "We study English on Mondays.", "es": "Estudiamos inglés los lunes.", "goal": "study" },
            { "en": "They watch movies on weekends.", "es": "Ellos miran películas los fines de semana.", "goal": "entertainment" }
          ]
        },
        {
          "key": "u1l1-t2",
          "titleEs": "Preguntas y negaciones con do/does",
          "bodyEs": "Para preguntar o negar en presente simple usamos do/does (does con he/she/it) + el verbo en forma base, sin -s.",
          "examples": [
            { "en": "Does he like coffee?", "es": "¿A él le gusta el café?", "goal": "general" },
            { "en": "Does she work on Saturdays?", "es": "¿Ella trabaja los sábados?", "goal": "work" },
            { "en": "Do you travel a lot for fun?", "es": "¿Viajás mucho por diversión?", "goal": "travel" },
            { "en": "I don't understand this word.", "es": "No entiendo esta palabra.", "goal": "study" },
            { "en": "He doesn't like horror movies.", "es": "A él no le gustan las películas de terror.", "goal": "entertainment" }
          ]
        }
      ],
