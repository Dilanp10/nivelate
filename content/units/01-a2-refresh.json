          "payload": {
            "prompt": "She ___ coffee every morning.",
            "options": ["drink", "drinks", "drinking"],
            "correctIndex": 1,
            "explanation": "En tercera persona del singular (she) el verbo lleva -s: 'drinks'."
          }
        },
        {
          "key": "u1l1-e2",
          "type": "multiple_choice",
          "payload": {
            "prompt": "They ___ in a big city.",
            "options": ["live", "lives", "living"],
            "correctIndex": 0,
            "explanation": "Con 'they' el verbo va en forma base, sin -s."
          }
        },
        {
          "key": "u1l1-e3",
          "type": "fill_in_blank",
          "payload": {
            "segments": ["My brother ", " to work by bus."],
