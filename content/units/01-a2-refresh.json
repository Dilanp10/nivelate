      "slug": "present-simple-review",
      "title": "Presente simple",
      "grammarTopicSlugs": [
        "present-simple"
      ],
      "teachingCards": [
        {
          "key": "u1l1-t1",
          "titleEs": "Rutinas y hechos generales",
          "bodyEs": "El presente simple se usa para rutinas, hábitos y hechos que siempre son ciertos. Con he/she/it, el verbo lleva -s al final.",
          "examples": [
            {
              "en": "I wake up early every day.",
              "es": "Me despierto temprano todos los días.",
              "goal": "general"
            },
            {
              "en": "She manages a small team.",
              "es": "Ella dirige un equipo pequeño.",
              "goal": "work"
            },
            {
              "en": "He travels twice a year.",
              "es": "Él viaja dos veces al año.",
              "goal": "travel"
            },
            {
              "en": "We study English on Mondays.",
              "es": "Estudiamos inglés los lunes.",
              "goal": "study"
            },
            {
              "en": "They watch movies on weekends.",
              "es": "Ellos miran películas los fines de semana.",
              "goal": "entertainment"
            }
          ]
        },
        {
          "key": "u1l1-t2",
          "titleEs": "Preguntas y negaciones con do/does",
          "bodyEs": "Para preguntar o negar en presente simple usamos do/does (does con he/she/it) + el verbo en forma base, sin -s.",
          "examples": [
            {
              "en": "Does he like coffee?",
              "es": "¿A él le gusta el café?",
              "goal": "general"
            },
            {
              "en": "Does she work on Saturdays?",
              "es": "¿Ella trabaja los sábados?",
              "goal": "work"
            },
            {
              "en": "Do you travel a lot for fun?",
              "es": "¿Viajás mucho por diversión?",
              "goal": "travel"
            },
            {
              "en": "I don't understand this word.",
              "es": "No entiendo esta palabra.",
              "goal": "study"
            },
            {
              "en": "He doesn't like horror movies.",
              "es": "A él no le gustan las películas de terror.",
              "goal": "entertainment"
            }
          ]
        },
        {
          "key": "u1l1-t3",
          "titleEs": "Adverbios de frecuencia",
          "bodyEs": "always, usually, often, sometimes y never dicen con qué frecuencia hacés algo. Van entre el sujeto y el verbo: 'I always wake up early'. Con el verbo 'be' van después: 'She is often late'.",
          "examples": [
            {
              "en": "I always brush my teeth before bed.",
              "es": "Siempre me lavo los dientes antes de dormir.",
              "goal": "general"
            },
            {
              "en": "She usually starts work at nine.",
              "es": "Ella normalmente empieza a trabajar a las nueve.",
              "goal": "work"
            },
            {
              "en": "We sometimes travel abroad in summer.",
              "es": "A veces viajamos al exterior en verano.",
              "goal": "travel"
            },
            {
              "en": "I often review my notes before class.",
              "es": "Reviso a menudo mis notas antes de clase.",
              "goal": "study"
            },
            {
              "en": "He never watches romantic movies.",
              "es": "Él nunca mira películas románticas.",
              "goal": "entertainment"
            }
          ]
        },
        {
          "key": "u1l1-t4",
          "titleEs": "Hechos y horarios fijos",
          "bodyEs": "El presente simple también describe hechos que no cambian (leyes de la naturaleza, verdades) y horarios fijos (transportes, comercios, servicios).",
          "examples": [
            {
              "en": "Water boils at 100 degrees Celsius.",
              "es": "El agua hierve a 100 grados Celsius.",
              "goal": "general"
            },
            {
              "en": "The office opens at eight.",
              "es": "La oficina abre a las ocho.",
              "goal": "work"
            },
            {
              "en": "The train to Rome leaves at noon.",
              "es": "El tren a Roma sale al mediodía.",
              "goal": "travel"
            },
            {
              "en": "The library closes on Sundays.",
              "es": "La biblioteca cierra los domingos.",
              "goal": "study"
            },
            {
              "en": "The show starts at nine.",
              "es": "El show empieza a las nueve.",
              "goal": "entertainment"
            }
          ]
        }
      ],
