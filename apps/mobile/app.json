{
  "expo": {
    "name": "Nivelate",
    "slug": "nivelate",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "nivelate",
    "newArchEnabled": true,
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Nivelate — Inglés A2 a B1",
      "shortName": "Nivelate",
      "description": "Aprendé inglés A2 → B1 en serio. PWA gratis, sin mascotas.",
      "lang": "es",
      "themeColor": "#FBFAF8",
      "backgroundColor": "#FBFAF8",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "/"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.nivelate.mobile"
    },
    "android": {
      "package": "app.nivelate.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#FBFAF8"
      }
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": false
    }
  }
}
